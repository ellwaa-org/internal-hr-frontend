# Copy to .env for local development. Do not commit .env.

# --- Local + Coolify ---
# Safe in the browser. Vite inlines every VITE_* key into the JS bundle.
# Already includes the /api prefix (SSO start is {VITE_API_URL}/auth/sso?redirect=true).
VITE_API_URL=/api

# Server-side only (Vite proxy + nginx). Do NOT name this VITE_* or it leaks
# into the client. Coolify: Runtime only — do not enable "Available at Buildtime".
API_PROXY_TARGET=https://hr-api-staging.ellwaa.com

# Backend allowlist for the web SSO return (not a frontend env var):
#   OIDC_FRONTEND_REDIRECT=https://YOUR_WEB_ORIGIN/auth/sso
#   OIDC_REDIRECT_URI={API_URL}/api/auth/sso/callback
