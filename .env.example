# Copy to .env for local development. Do not commit .env.

# Local dev only: keep /api to use the Vite dev proxy (avoids CORS on
# localhost). Production builds call the API directly using the built-in
# default (https://hr-api.ellwaa.com/api) — no env var needed.
VITE_API_URL=/api

# Local dev only (`npm run dev`): Vite proxies /api to avoid CORS on localhost.
# Not used in production — the browser calls the API directly.
API_PROXY_TARGET=https://hr-api.ellwaa.com
