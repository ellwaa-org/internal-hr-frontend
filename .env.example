# Copy to .env for local development. Do not commit .env.

# Browser API prefix. Vite forwards /api to API_PROXY_TARGET.
VITE_API_URL=/api

# Server-side only: upstream API origin for Vite and production nginx.
API_PROXY_TARGET=https://hr-api.ellwaa.com

# Local dev only: Vite dev-server port override (each app has its own default).
# VITE_DEV_SERVER_PORT=
