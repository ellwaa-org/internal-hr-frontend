# Copy to .env.docker (or export) and pass with:
#   docker compose --env-file .env.docker up --build

# Host port mapped to container :80
APP_PORT=8080

# Client API base baked at image build (prefer /api + nginx proxy)
VITE_API_URL=/api

# Backend the container proxies /api → (scheme + host, no trailing slash)
API_PROXY_TARGET=https://hr-api-staging.ellwaa.com
