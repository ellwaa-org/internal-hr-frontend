# Copy to .env.docker, then run:
# docker compose --env-file .env.docker up --build
#
# Coolify: Dockerfile build pack, exposed port 3000, health check /healthz.
# Set VITE_API_URL at build time; set PORT at runtime.
# The browser calls the API directly. The API must allow the website origin
# through CORS. Include /api in the URL. Rebuild after changing VITE_API_URL.

APP_PORT=3000
PORT=3000
IMAGE_TAG=local
VITE_API_URL=https://hr-api.ellwaa.com/api
