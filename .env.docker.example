# Copy to .env.docker, then run:
# docker compose --env-file .env.docker up --build
#
# Coolify: Dockerfile build pack, exposed port 3000, health check /healthz.
# Set VITE_API_URL at build time; set PORT and API_PROXY_TARGET at runtime.
# nginx forwards /api requests to API_PROXY_TARGET (origin only, no /api).

APP_PORT=3000
PORT=3000
IMAGE_TAG=local
VITE_API_URL=/api
API_PROXY_TARGET=https://hr-api.ellwaa.com
