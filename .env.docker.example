# -----------------------------------------------------------------------------
# Coolify (recommended for hr-staging.ellwaa.com)
# -----------------------------------------------------------------------------
# Application → General:
#   Build Pack     = Dockerfile
#   Port Exposes   = 80
#
# Application → Healthchecks:
#   Enabled        = true
#   Path           = /healthz
#   Return Code    = 200
#   Method         = GET
#
# Application → Environment Variables:
#   API_PROXY_TARGET=https://hr-api-staging.ellwaa.com
#   (optional — image already defaults to this value)
#
# Then Redeploy. Cloudflare 502 clears once the container stays healthy.
# -----------------------------------------------------------------------------

# Local compose only:
#   copy .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build

APP_PORT=8080
IMAGE_TAG=local
VITE_API_URL=/api
API_PROXY_TARGET=https://hr-api-staging.ellwaa.com
