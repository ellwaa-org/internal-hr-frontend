# -----------------------------------------------------------------------------
# Coolify — required to avoid Cloudflare 502
# -----------------------------------------------------------------------------
# Application → General / Network:
#   Build Pack     = Dockerfile
#   Port Exposes   = 3000          ← must match container listen port
#
# Application → Healthchecks:
#   Path           = /healthz
#   Return Code    = 200
#
# Application → Environment Variables:
#   PORT=3000
#   API_PROXY_TARGET=<same host as VITE_API_PROXY_TARGET in .env>
#
# Redeploy after changing Port Exposes from 80 → 3000.
# -----------------------------------------------------------------------------

# Local compose:
#   copy .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build

APP_PORT=3000
PORT=3000
IMAGE_TAG=local
VITE_API_URL=/api
VITE_API_PROXY_TARGET=
