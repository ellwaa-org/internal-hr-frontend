# -----------------------------------------------------------------------------
# Coolify Environment Variables (Application → Environment Variables)
# -----------------------------------------------------------------------------
# Paste these. None of them are secrets (public API origin + listen port).
#
#   Name                 Value                                      Buildtime?
#   PORT                 3000                                       No (runtime)
#   API_PROXY_TARGET     https://hr-api-staging.ellwaa.com          No (runtime)
#   VITE_API_URL         /api                                       Optional Yes
# Backend must allowlist the SPA return: OIDC_FRONTEND_REDIRECT=https://YOUR_WEB/auth/sso
#
# The browser calls the API directly (CORS). There is no server-side proxy,
# so API_PROXY_TARGET is no longer used.
#
# Network:
#   Build Pack     = Dockerfile
#   Port Exposes   = 3000
# Healthcheck:
#   Path           = /healthz
#   Return Code    = 200
# -----------------------------------------------------------------------------

# Local compose:
#   copy .env.docker.example .env.docker
#   docker compose --env-file .env.docker up --build

APP_PORT=3000
PORT=3000
IMAGE_TAG=local
VITE_API_URL=https://hr-api.ellwaa.com
