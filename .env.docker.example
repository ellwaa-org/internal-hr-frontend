# Copy to .env.docker and fill in real values:
#   copy .env.docker.example .env.docker
#
# Local:
#   docker compose --env-file .env.docker up --build
#
# Production:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml --env-file .env.docker up -d --build

# Host port mapped to container :80
APP_PORT=8080

# Image tag (use a version/git sha in production)
IMAGE_TAG=local

# Client API base baked at image build (prefer /api + nginx proxy)
VITE_API_URL=/api

# Backend the container proxies /api → (scheme + host, no trailing slash)
# Also set this in Coolify → Environment Variables for production.
# Staging example:
API_PROXY_TARGET=https://hr-api-staging.ellwaa.com
# Production example:
# API_PROXY_TARGET=https://hr-api.ellwaa.com
